# HunterCTR AI configuration
# Copy to .env.local and fill in to enable the live Claude-powered engine.
# Without a key, the app runs in fully-functional DEMO mode.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
# Model used for analysis + generation (defaults to claude-opus-4-8).
# claude-sonnet-4-6 is a cheaper/faster alternative for high volume.
HUNTER_MODEL=claude-opus-4-8

# Max output tokens for the generated package.
HUNTER_MAX_TOKENS=8000
